// Resumen de gastos del mes
//
// Toma los gastos de un mes, los agrupa por categoría, controla el presupuesto
// de cada una y proyecta cuánto costaría el mismo mes con inflación.
//
// Lox no trae listas, ni registros, ni forma de pasar un número a texto, así
// que el programa los arma con lo único que hay: funciones y closures.
//   - Una lista es una cadena de "celdas": cada celda es una closure que
//     recuerda su cabeza y su cola.
//   - Un gasto es una closure que responde por sus campos.
//   - Los montos se formatean ("$12.345,50") con aritmética pura.
//
// Uso: ./glox examples/gastos.lox

// ---------------------------------------------------------------------------
// Números a texto
// ---------------------------------------------------------------------------

fun digito(d) {
    if (d == 0) return "0";
    if (d == 1) return "1";
    if (d == 2) return "2";
    if (d == 3) return "3";
    if (d == 4) return "4";
    if (d == 5) return "5";
    if (d == 6) return "6";
    if (d == 7) return "7";
    if (d == 8) return "8";
    return "9";
}

// Entero no negativo a texto, con punto como separador de miles.
// `posicion` cuenta cuántos dígitos ya quedaron a la derecha.
fun digitosDesde(n, posicion) {
    if (n < 10) return digito(n);
    var ultimo = n % 10;
    var separador = "";
    if (posicion % 3 == 2) separador = ".";
    return digitosDesde((n - ultimo) / 10, posicion + 1) + separador + digito(ultimo);
}

fun enteroATexto(n) { return digitosDesde(n, 0); }

fun redondear(n) {
    var fraccion = n % 1;
    if (fraccion >= 0.5) return n - fraccion + 1;
    return n - fraccion;
}

// Monto a texto con dos decimales: 12345.5 -> "$12.345,50".
fun pesos(monto) {
    var signo = "";
    if (monto < 0) {
        signo = "-";
        monto = -monto;
    }
    var centavos = redondear(monto * 100);
    var c = centavos % 100;
    var texto = signo + "$" + enteroATexto((centavos - c) / 100) + ",";
    if (c < 10) texto = texto + "0";
    return texto + enteroATexto(c);
}

fun porcentaje(parte, total) {
    return enteroATexto(redondear(parte * 100 / total)) + "%";
}

// ---------------------------------------------------------------------------
// Listas hechas con closures
// ---------------------------------------------------------------------------

fun cons(cabeza, cola) {
    fun celda(pedido) {
        if (pedido == "cabeza") return cabeza;
        return cola;
    }
    return celda;
}

fun cabeza(lista) { return lista("cabeza"); }
fun cola(lista) { return lista("cola"); }

fun largo(lista) {
    var n = 0;
    while (lista != nil) {
        n = n + 1;
        lista = cola(lista);
    }
    return n;
}

fun recorrer(lista, accion) {
    while (lista != nil) {
        accion(cabeza(lista));
        lista = cola(lista);
    }
}

fun mapear(lista, f) {
    if (lista == nil) return nil;
    return cons(f(cabeza(lista)), mapear(cola(lista), f));
}

fun filtrar(lista, cumple) {
    if (lista == nil) return nil;
    if (cumple(cabeza(lista))) return cons(cabeza(lista), filtrar(cola(lista), cumple));
    return filtrar(cola(lista), cumple);
}

fun plegar(lista, inicial, combinar) {
    var acumulado = inicial;
    while (lista != nil) {
        acumulado = combinar(acumulado, cabeza(lista));
        lista = cola(lista);
    }
    return acumulado;
}

fun tomar(lista, n) {
    if (lista == nil or n == 0) return nil;
    return cons(cabeza(lista), tomar(cola(lista), n - 1));
}

fun contiene(lista, valor) {
    while (lista != nil) {
        if (cabeza(lista) == valor) return true;
        lista = cola(lista);
    }
    return false;
}

// Ordenamiento por inserción. `vaAntes(a, b)` decide el orden.
fun ordenar(lista, vaAntes) {
    fun insertar(ordenada, x) {
        if (ordenada == nil) return cons(x, nil);
        if (vaAntes(x, cabeza(ordenada))) return cons(x, ordenada);
        return cons(cabeza(ordenada), insertar(cola(ordenada), x));
    }
    return plegar(lista, nil, insertar);
}

// ---------------------------------------------------------------------------
// Gastos
// ---------------------------------------------------------------------------

fun gasto(dia, descripcion, categoria, monto) {
    fun campo(nombre) {
        if (nombre == "dia") return dia;
        if (nombre == "descripcion") return descripcion;
        if (nombre == "categoria") return categoria;
        if (nombre == "monto") return monto;
        return nil;
    }
    return campo;
}

fun monto(g) { return g("monto"); }
fun categoria(g) { return g("categoria"); }

fun sumarMontos(lista) {
    fun sumar(total, g) { return total + monto(g); }
    return plegar(lista, 0, sumar);
}

fun deCategoria(nombre) {
    fun esDeCategoria(g) { return categoria(g) == nombre; }
    return esDeCategoria;
}

fun menoresA(tope) {
    fun esMenor(g) { return monto(g) < tope; }
    return esMenor;
}

fun imprimirGasto(g) {
    print "  día " + enteroATexto(g("dia")) + "  " + g("descripcion") + " (" + categoria(g) + "): " + pesos(monto(g));
}

// Los gastos se cargan en orden inverso para que la lista quede por fecha.
var gastos = nil;
gastos = cons(gasto(28, "Cena de cumpleaños", "salidas", 38500), gastos);
gastos = cons(gasto(27, "Supermercado", "comida", 52340.75), gastos);
gastos = cons(gasto(25, "Carga SUBE", "transporte", 8000), gastos);
gastos = cons(gasto(22, "Café", "comida", 3200), gastos);
gastos = cons(gasto(20, "Internet", "servicios", 21999.99), gastos);
gastos = cons(gasto(18, "Cine", "salidas", 9800), gastos);
gastos = cons(gasto(15, "Verdulería", "comida", 11420.5), gastos);
gastos = cons(gasto(12, "Luz", "servicios", 18750.3), gastos);
gastos = cons(gasto(10, "Café", "comida", 2900), gastos);
gastos = cons(gasto(8, "Carga SUBE", "transporte", 8000), gastos);
gastos = cons(gasto(6, "Supermercado", "comida", 47810.2), gastos);
gastos = cons(gasto(5, "Gas", "servicios", 9340), gastos);
gastos = cons(gasto(3, "Café", "comida", 2750), gastos);
gastos = cons(gasto(2, "Nafta", "transporte", 35000), gastos);
gastos = cons(gasto(1, "Alquiler", "vivienda", 450000), gastos);

// ---------------------------------------------------------------------------
// Reporte
// ---------------------------------------------------------------------------

print "=== Gastos de septiembre ===";
recorrer(gastos, imprimirGasto);

var total = sumarMontos(gastos);
var cantidad = largo(gastos);
print "";
print "Total: " + pesos(total) + " en " + enteroATexto(cantidad) + " gastos";
print "Promedio por gasto: " + pesos(total / cantidad);

// Categorías distintas, de la que más pesa a la que menos.
fun agregarSiNoEsta(categorias, g) {
    if (contiene(categorias, categoria(g))) return categorias;
    return cons(categoria(g), categorias);
}
fun subtotal(nombre) { return sumarMontos(filtrar(gastos, deCategoria(nombre))); }
fun pesaMas(a, b) { return subtotal(a) > subtotal(b); }
var categorias = ordenar(plegar(gastos, nil, agregarSiNoEsta), pesaMas);

print "";
print "=== Por categoría ===";
fun imprimirCategoria(nombre) {
    var s = subtotal(nombre);
    print "  " + nombre + ": " + pesos(s) + " (" + porcentaje(s, total) + ")";
}
recorrer(categorias, imprimirCategoria);

print "";
print "=== Los 3 gastos más grandes ===";
fun masCaro(a, b) { return monto(a) > monto(b); }
recorrer(tomar(ordenar(gastos, masCaro), 3), imprimirGasto);

// Gastos "hormiga": los chicos que, sumados, pesan.
var hormiga = filtrar(gastos, menoresA(5000));
print "";
print "=== Gastos hormiga (menos de $5.000) ===";
recorrer(hormiga, imprimirGasto);
print "  Suman " + pesos(sumarMontos(hormiga));

// Cada presupuesto es una closure con su propio acumulado: recuerda cuánto
// se gastó entre llamadas sin que nadie de afuera pueda tocarlo.
fun crearPresupuesto(nombre, limite) {
    var gastado = 0;
    fun registrar(g) {
        if (categoria(g) != nombre) return;
        gastado = gastado + monto(g);
        if (gastado > limite) {
                    print "  ALERTA día " + enteroATexto(g("dia")) + ": " + nombre + " se pasó del presupuesto de " + pesos(limite) + " (lleva " + pesos(gastado) + ")";
        }
    }
    return registrar;
}

print "";
print "=== Control de presupuesto ===";
var presupuestos = nil;
presupuestos = cons(crearPresupuesto("comida", 100000), presupuestos);
presupuestos = cons(crearPresupuesto("salidas", 40000), presupuestos);
presupuestos = cons(crearPresupuesto("transporte", 60000), presupuestos);

fun controlar(g) {
    fun aplicar(presupuesto) { presupuesto(g); }
    recorrer(presupuestos, aplicar);
}
recorrer(gastos, controlar);

// Proyección: el mismo mes con una inflación mensual constante. Componer
// funciones permite armar "aplicar la inflación n veces" sin ningún loop.
fun ajustePor(inflacion) {
    fun ajustar(monto) { return monto * (1 + inflacion / 100); }
    return ajustar;
}

fun componer(f, g) {
    fun compuesta(x) { return f(g(x)); }
    return compuesta;
}

fun repetir(f, veces) {
    if (veces == 1) return f;
    return componer(f, repetir(f, veces - 1));
}

print "";
print "=== Proyección con 3% de inflación mensual ===";
var ajusteMensual = ajustePor(3);
for (var mes = 1; mes <= 3; mes = mes + 1) {
    print "  En " + enteroATexto(mes) + " mes(es): " + pesos(repetir(ajusteMensual, mes)(total));
}
