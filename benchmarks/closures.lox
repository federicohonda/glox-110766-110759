// Benchmark: Generación y ejecución masiva de closures
// Evalúa el costo de instanciar funciones que capturan su entorno léxico (enclosing environment),
// retención de variables en memoria y posterior invocación.
// Instancia 10.000 closures distintos y los invoca, retornando 50005000.

fun makeAdder(x) {
    fun add(y) {
        return x + y;
    }
    return add;
}

var sum = 0;
for (var i = 0; i < 10000; i = i + 1) {
    var adder = makeAdder(i);
    sum = sum + adder(1);
}
print sum;
